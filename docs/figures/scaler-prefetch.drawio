<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="32.5.5">
  <diagram id="scaler-prefetch" name="预取缩放数据路径">
    <mxGraphModel page="1" pageWidth="1700" pageHeight="760" background="#ffffff" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="预取缩放器数据路径" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;fontColor=#172b3a;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1600" height="50" as="geometry" /></mxCell>
        <mxCell id="in" value="AXI4-Stream 输入&#10;RGB888&#10;SOF / EOL&#10;TVALID / TREADY" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2f8;strokeColor=#466d88;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="45" y="270" width="155" height="140" as="geometry" /></mxCell>
        <mxCell id="frame" value="帧同步与行校验&#10;等待有效 SOF&#10;检查行宽与 TLAST" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2f8;strokeColor=#466d88;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="235" y="270" width="175" height="140" as="geometry" /></mxCell>
        <mxCell id="capture" value="逐行采集&#10;选择可复用 bank&#10;写入完整源行" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#eaf2f8;strokeColor=#466d88;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="445" y="270" width="180" height="140" as="geometry" /></mxCell>
        <mxCell id="bank0" value="BRAM bank 0&#10;RGB888 像素行&#10;source_y 标签 + valid" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#e8f5e9;strokeColor=#4e7a50;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="665" y="175" width="195" height="105" as="geometry" /></mxCell>
        <mxCell id="bank1" value="BRAM bank 1&#10;RGB888 像素行&#10;source_y 标签 + valid" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#e8f5e9;strokeColor=#4e7a50;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="665" y="395" width="195" height="105" as="geometry" /></mxCell>
        <mxCell id="select" value="行标签匹配&#10;line_y = source_y&#10;选择有效 bank" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#e8f5e9;strokeColor=#4e7a50;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="905" y="275" width="175" height="130" as="geometry" /></mxCell>
        <mxCell id="bram" value="同步 BRAM 读取&#10;地址 = source_x&#10;一拍后 read_valid" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#e8f5e9;strokeColor=#4e7a50;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1110" y="275" width="180" height="130" as="geometry" /></mxCell>
        <mxCell id="map" value="逐行活动窗口&amp;#xa;有效区读取源像素&amp;#xa;边框位置输出黑色" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#fff2cc;strokeColor=#b38700;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1320" y="275" width="180" height="130" as="geometry" /></mxCell>
        <mxCell id="out" value="AXI4-Stream 输出&#10;缩放或精确 1:1 直通&#10;RGB888 / SOF / EOL" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#e0f2f1;strokeColor=#568a88;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1530" y="275" width="160" height="130" as="geometry" /></mxCell>
        <mxCell id="config" value="AXI-Lite 几何 profile + X/Y DDA&amp;#xa;输出坐标生成 source_x / source_y&amp;#xa;活动窗口控制有效区" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fillColor=#fff2cc;strokeColor=#b38700;strokeWidth=2;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="920" y="550" width="580" height="85" as="geometry" /></mxCell>
        <mxCell id="note" value="双行 bank 保存完整输入行，source_y 标签决定输出行读取的源行。" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#f3f7f9;strokeColor=#8ba0ad;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="45" y="650" width="800" height="55" as="geometry" /></mxCell>
